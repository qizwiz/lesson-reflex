#!/usr/bin/env python3
"""lesson -- record and review the lessons lesson-reflex fires at the action.

  lesson add --tool Bash|Edit|MultiEdit|Write --needle TEXT --lesson TEXT [--source ID]
  lesson list
  lesson pending              corrections the judge flagged that no lesson cites yet, and judge errors
  lesson dismiss ID           the judge misread it: drop it from the queue (kept in dismissed.txt)
  lesson rm TOOL NEEDLE       delete a lesson

The needle is plain text that appears in the action where the mistake started: a command, a function name, a
flag. When Claude is about to run a Bash command or write Edit/Write text containing it, the lesson is injected.
"""
import json
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks"))
import store  # noqa: E402


def parse(argv):
    """PURE: argv -> {flag: value}, or an error string."""
    out, i = {}, 0
    while i < len(argv):
        k = argv[i]
        if not k.startswith("--") or i + 1 >= len(argv):
            return f"bad argument: {k!r}"
        out[k[2:]] = argv[i + 1]
        i += 2
    return out


def add(argv):
    got = parse(argv)
    if isinstance(got, str):
        print(got, file=sys.stderr)
        return 64
    row = {k: str(got.get(k, "")) for k in ("tool", "needle", "lesson", "source")}
    row["needle"] = row["needle"].strip()
    lp = store.path("lessons.jsonl")
    with store.locked("lessons.lock"):
        why = store.validate(row, store.read_jsonl(lp))
        if why:
            print(f"lesson: REFUSED -- {why}", file=sys.stderr)
            return 64
        row["at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
        store.append_jsonl(lp, row)
    print(f"lesson: added -- {row['tool']} actions containing {row['needle']!r} now carry it")
    return 0


def rm(tool, needle):
    needle = needle.strip()
    lp = store.path("lessons.jsonl")
    with store.locked("lessons.lock"):
        rows = store.read_jsonl(lp)
        keep = [r for r in rows if not (r.get("tool") == tool and r.get("needle") == needle)]
        if len(keep) == len(rows):
            print("lesson: no such lesson", file=sys.stderr)
            return 64
        store.write_atomic(lp, "".join(json.dumps(r) + "\n" for r in keep))
    print("lesson: removed")
    return 0


def pending():
    corrections = store.read_jsonl(store.path("corrections.jsonl"))
    rows = store.pending(corrections, store.read_jsonl(store.path("lessons.jsonl")), store.dismissed_ids())
    for c in rows:
        print(f"{c['id']}  {str(c.get('prompt', ''))[:110]!r}")
    print(f"-- {len(rows)} correction(s) with no lesson yet")
    recent = corrections[-50:]
    errors = [c for c in recent if c.get("verdict") in ("judge-error", "error", "busy")]  # "error": rows before 0.3
    if errors:
        print(f"-- the judge did not answer {len(errors)} of the last {len(recent)} judgements; latest: "
              f"{errors[-1].get('error') or errors[-1].get('verdict')}")
    return 0


def dismiss(cid):
    corrections = {c.get("id"): c for c in store.read_jsonl(store.path("corrections.jsonl"))}
    if corrections.get(cid, {}).get("verdict") != "correction":
        print(f"lesson: no correction {cid}", file=sys.stderr)
        return 64
    if cid not in store.dismissed_ids():
        store.ensure_home()
        fd = os.open(store.path("dismissed.txt"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as fh:
            fh.write(cid + "\n")
    print(f"lesson: dismissed {cid}")
    return 0


def main(argv):
    cmd = argv[1:2]
    if cmd == ["add"]:
        return add(argv[2:])
    if cmd == ["list"]:
        for r in store.read_jsonl(store.path("lessons.jsonl")):
            print(f"{str(r.get('tool', '?')):<9} {str(r.get('needle', ''))!r:<28} {str(r.get('lesson', ''))[:90]}")
        return 0
    if cmd == ["pending"]:
        return pending()
    if cmd == ["dismiss"] and len(argv) == 3:
        return dismiss(argv[2])
    if cmd == ["rm"] and len(argv) == 4:
        return rm(argv[2], argv[3])
    print(__doc__)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv))
